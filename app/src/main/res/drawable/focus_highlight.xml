<?xml version="1.0" encoding="utf-8"?>
<!--
    Replaces the platform's default focus ring (a bright green box on this
    device) with a subtle blue outline in the app's accent color. Android uses
    ?android:attr/selectableItemBackground for its default focus highlight.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2dp" android:color="#FF4A90E2" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#334A90E2" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
