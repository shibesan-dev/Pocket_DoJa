    <string name="app_name">Pocket DoJa</string>
    <string name="title_pocket_doja">Pocket DoJa</string>
    <string name="no_installed_games">நிறுவப்பட்ட விளையாட்டுகள் இல்லை\n.JAM இறக்குமதி செய்ய மேல் வலது மெனுவைப் பயன்படுத்தவும்</string>
    <string name="search">தேடு</string>
    <string name="about_body">Pocket DoJa என்பது OpenDoJa அடிப்படையிலான Android எமுலேட்டர் திட்டமாகும், இது கிளாசிக் NTT DoCoMo i-mode Java விளையாட்டுகளின் அனுபவத்தை ஆராய்ந்து பாதுகாக்க அர்ப்பணிக்கப்பட்டுள்ளது.</string>
    <string name="paypal_label">"PayPal: "</string>
    <string name="wallet_label">"வாலட் முகவரி: "</string>
    <string name="footer_donations">நன்கொடைகள் முழுவதும் விருப்பத்தேர்வு மட்டுமே; தொடர்ச்சியான மேம்பாடு மற்றும் பாதுகாப்பு முயற்சிகளுக்கு உதவுகின்றன.\n\nPocket DoJa மீதான உங்கள் ஆர்வத்திற்கு நன்றி!\n\n</string>
