    <string name="reset_data_title">விளையாட்டு தரவை மீட்டமைக்கவா?</string>
    <string name="reset_data_message">விளையாட்டின் அசல் தரவை (scratchpad) மீட்டெடுக்கும். விளையாட்டு இறக்குமதி செய்யப்பட்ட பிறகு சேமிக்கப்பட்ட எந்த முன்னேற்றமும் அமைப்புகளும் இழக்கப்படும்.</string>
    <string name="reset_data_done">விளையாட்டு தரவு அசலுக்கு மீட்டமைக்கப்பட்டது</string>
    <string name="reset_data_failed">மீட்டமைப்பு தோல்வியடைந்தது:</string>
    <string name="reset_data_unavailable">அசல் தரவு ஸ்னாப்ஷாட் எதுவும் இல்லை</string>
    <string name="corrupt_data_title">சேதமடைந்த விளையாட்டு தரவு</string>
    <string name="corrupt_data_message">இந்த விளையாட்டின் சேமிக்கப்பட்ட தரவு சேதமடைந்துள்ளதால் அது தொடங்காமல் போகலாம் (எடுத்துக்காட்டாக \"இணைப்பு பிழை\"). அசல் விளையாட்டு தரவுக்கு மீட்டமைக்கவா? சேமிக்கப்பட்ட முன்னேற்றம் இழக்கப்படும். விளையாட்டு பட்டியலிலிருந்து பின்னர் இதைச் செய்யலாம்: விளையாட்டை நீண்ட நேரம் அழுத்தி, \"விளையாட்டு தரவை மீட்டமை\" என்பதைத் தட்டவும்.</string>
